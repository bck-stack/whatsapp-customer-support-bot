# Meta App Dashboard → WhatsApp → API Setup
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxx
WHATSAPP_PHONE_ID=1234567890123456
GRAPH_API_VERSION=v21.0

# Arbitrary string — must match what you enter in the Meta webhook config
VERIFY_TOKEN=my_random_verify_token_here
# Meta App Dashboard → App settings → Basic → App secret (verifies X-Hub-Signature-256)
META_APP_SECRET=

# Required to call POST /notify/order (send as X-API-Key)
NOTIFY_API_KEY=change_me

# Shown in replies
BUSINESS_NAME=My Business
SUPPORT_EMAIL=support@example.com
SUPPORT_HOURS=Mon–Fri 9AM–6PM
# Optional staff number (country code, digits) that receives "talk to support" requests
SUPPORT_FORWARD_NUMBER=

# Order lookup data (replace OrderStore with your DB/API in app/orders.py)
ORDERS_FILE=data/orders.json

# Approved template for notifications outside the 24h window
# Body example: "Hi {{1}}, your order {{2}} is now {{3}}. {{4}}"
ORDER_TEMPLATE_NAME=
ORDER_TEMPLATE_LANGUAGE=en_US

SESSION_TTL_MINUTES=30
